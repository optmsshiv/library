Options -Indexes
RewriteEngine On
RewriteRule ^api/(.*)$ api/index.php?action=$1 [QSA,L]

# Force clean connection after logout — fixes Chrome ERR_FAILED on redirect
<FilesMatch "logout\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Clear-Site-Data "\"cache\", \"cookies\""
    Header always set Connection "close"
</FilesMatch>

# Prevent caching of login page
<FilesMatch "login\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
</FilesMatch>